// ServiceNow360 — portail anomalies + suivi de projet
// Modèle de données dérivé du cahier des charges (v0.1)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// Utilisateurs, projets, rôles (Module 3)
// ─────────────────────────────────────────────────────────────

enum AccountStatus {
  PENDING // compte auto-inscrit, en attente d'affectation par l'administrateur
  ACTIVE
  DISABLED
}

enum ProjectRole {
  USER // utilisateur standard (client) — voit ses propres tickets
  MEMBER // membre de l'équipe projet — voit tous les tickets, participe sans arbitrer
  SUPERVISOR // superviseur — voit tous les tickets du projet
  TECHNICIAN // technicien IT — traite les tickets assignés
  PROJECT_MANAGER // chef de projet — pilote le planning et arbitre
}

model User {
  id           String        @id @default(cuid())
  firstName    String
  lastName     String
  email        String        @unique
  company      String
  phone        String?
  jobRole      String?
  country      String?
  passwordHash String
  isAdmin      Boolean       @default(false)
  status       AccountStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  memberships     ProjectMember[]
  createdTickets  Ticket[]         @relation("TicketCreator")
  assignedTickets Ticket[]         @relation("TicketAssignee")
  comments        TicketComment[]
  ticketEvents    TicketEvent[]
  ownedTasks      Task[]           @relation("TaskOwner")
  taskComments    TaskComment[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  risks           Risk[]           @relation("RiskOwner")
  attachments     Attachment[]
  handledContacts ContactMessage[] @relation("ContactHandler")

  @@index([status])
}

model Project {
  id          String    @id @default(cuid())
  code        String    @unique // préfixe métier du projet, ex. "PORTAIL"
  name        String
  clientName  String
  description String?
  startDate   DateTime?
  endDate     DateTime?
  archived    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  members   ProjectMember[]
  tickets   Ticket[]
  tasks     Task[]
  risks     Risk[]
  baselines PlanBaseline[]
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole @default(USER)
  createdAt DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// Module 1 — Tickets (incidents, évolutions, nouvelles demandes)
// ─────────────────────────────────────────────────────────────

enum TicketType {
  INCIDENT // INC- : dysfonctionnement, piloté par SLA
  EVOLUTION // EVO- : amélioration d'une fonctionnalité existante
  DEMANDE // DEM- : nouvelle fonctionnalité / nouveau module
}

enum TicketStatus {
  // Circuit incident
  NEW
  IN_QUALIFICATION
  ASSIGNED
  IN_PROGRESS
  WAITING_INFO
  RESOLVED
  REJECTED
  // Circuit évolution / nouvelle demande
  SUBMITTED
  IN_ANALYSIS
  ESTIMATED
  PENDING_ARBITRATION
  ACCEPTED_PLANNED
  REFUSED
  POSTPONED
  IN_DEVELOPMENT
  DELIVERED
  // Commun
  CLOSED
}

enum Severity {
  BLOCKING
  MAJOR
  MINOR
  COSMETIC
}

enum Priority {
  P1
  P2
  P3
  P4
}

model Ticket {
  id          String       @id @default(cuid())
  reference   String       @unique // INC-0001 / EVO-0001 / DEM-0001
  projectId   String
  type        TicketType
  status      TicketStatus
  title       String
  description String       @db.Text
  moduleName  String? // module / fonctionnalité concernée
  subCategory String? // sous-catégorie (cf. 3.1)

  // Champs spécifiques incident
  environmentName String? // production, recette, développement...
  severity        Severity?
  priority        Priority  @default(P3)
  reproSteps      String?   @db.Text

  // Champs spécifiques évolution / nouvelle demande
  businessJustification String? @db.Text
  expectedBenefit       String? @db.Text
  businessUrgency       String?
  estimatedBudget       String?
  estimateDays          Float?
  estimateCost          Float?
  arbitrationNote       String? @db.Text

  createdById String
  assigneeId  String?
  taskId      String? // rattachement à une tâche du planning (traçabilité demande -> réalisation)

  // SLA
  slaFirstResponseDue DateTime?
  slaResolutionDue    DateTime?
  firstResponseAt     DateTime?
  resolvedAt          DateTime?
  closedAt            DateTime?

  // Enquête de satisfaction à la clôture
  satisfactionRating  Int?
  satisfactionComment String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation("TicketCreator", fields: [createdById], references: [id])
  assignee  User?   @relation("TicketAssignee", fields: [assigneeId], references: [id])
  task      Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  comments    TicketComment[]
  events      TicketEvent[]
  attachments Attachment[]

  @@index([projectId, status])
  @@index([projectId, type])
  @@index([assigneeId])
  @@index([createdById])
}

model TicketComment {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  body      String   @db.Text
  internal  Boolean  @default(false) // note interne, invisible du client
  createdAt DateTime @default(now())

  ticket      Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      User         @relation(fields: [authorId], references: [id])
  attachments Attachment[]

  @@index([ticketId])
}

model TicketEvent {
  id        String   @id @default(cuid())
  ticketId  String
  actorId   String?
  field     String // "status", "assignee", "priority"...
  fromValue String?
  toValue   String?
  note      String?
  createdAt DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id])

  @@index([ticketId])
}

model Attachment {
  id           String   @id @default(cuid())
  ticketId     String?
  commentId    String?
  fileName     String
  mimeType     String
  size         Int
  data         String   @db.Text // data URL (base64) — suffisant pour captures et logs
  uploadedById String
  createdAt    DateTime @default(now())

  ticket     Ticket?        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  comment    TicketComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  uploadedBy User           @relation(fields: [uploadedById], references: [id])

  @@index([ticketId])
}

// ─────────────────────────────────────────────────────────────
// Module 2 — Planning / Gantt
// ─────────────────────────────────────────────────────────────

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  LATE
  BLOCKED
}

model Task {
  id          String     @id @default(cuid())
  projectId   String
  parentId    String?
  name        String
  description String?    @db.Text
  ownerId     String?
  startDate   DateTime
  endDate     DateTime
  progress    Int        @default(0) // 0..100
  status      TaskStatus @default(TODO)
  isMilestone Boolean    @default(false)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent       Task?            @relation("TaskTree", fields: [parentId], references: [id], onDelete: Cascade)
  children     Task[]           @relation("TaskTree")
  owner        User?            @relation("TaskOwner", fields: [ownerId], references: [id])
  predecessors TaskDependency[] @relation("DepSuccessor")
  successors   TaskDependency[] @relation("DepPredecessor")
  comments     TaskComment[]
  tickets      Ticket[]

  @@index([projectId])
}

enum DependencyType {
  FS // fin -> début
  SS
  FF
  SF
}

model TaskDependency {
  id            String         @id @default(cuid())
  predecessorId String
  successorId   String
  type          DependencyType @default(FS)
  lagDays       Int            @default(0)

  predecessor Task @relation("DepPredecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor   Task @relation("DepSuccessor", fields: [successorId], references: [id], onDelete: Cascade)

  @@unique([predecessorId, successorId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String   @db.Text
  createdAt DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@index([taskId])
}

// Historique des versions du planning (baseline vs planning actuel)
model PlanBaseline {
  id        String   @id @default(cuid())
  projectId String
  label     String
  snapshot  Json // [{ taskId, name, startDate, endDate, progress }]
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// Journal des risques et points d'attention
enum RiskStatus {
  OPEN
  MITIGATED
  CLOSED
}

model Risk {
  id               String     @id @default(cuid())
  projectId        String
  title            String
  description      String?    @db.Text
  probability      Int        @default(2) // 1..4
  impact           Int        @default(2) // 1..4
  status           RiskStatus @default(OPEN)
  ownerId          String?
  sharedWithClient Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  owner   User?   @relation("RiskOwner", fields: [ownerId], references: [id])

  @@index([projectId])
}

// ─────────────────────────────────────────────────────────────
// Module 5 — Notifications & journalisation
// ─────────────────────────────────────────────────────────────

model Notification {
  id          String    @id @default(cuid())
  userId      String
  title       String
  body        String
  link        String?
  readAt      DateTime?
  emailSentAt DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
}

model Counter {
  id    String @id // "INC" | "EVO" | "DEM"
  value Int    @default(0)
}

// ─────────────────────────────────────────────────────────────
// Formulaire de contact public
// ─────────────────────────────────────────────────────────────

enum ContactStatus {
  NEW
  READ
  HANDLED
  ARCHIVED
}

model ContactMessage {
  id        String        @id @default(cuid())
  firstName String
  lastName  String
  email     String
  company   String?
  phone     String?
  subject   String
  message   String        @db.Text
  status    ContactStatus @default(NEW)

  // Traitement cote administration
  handledById  String?
  handledAt    DateTime?
  internalNote String?   @db.Text

  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  handledBy User? @relation("ContactHandler", fields: [handledById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}
