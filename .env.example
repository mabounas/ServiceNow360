# PostgreSQL (Neon, Supabase, local...) — connexion poolée pour le runtime serverless.
# Derriere un pooler (Neon -pooler, PgBouncer, Prisma dev), ajouter pgbouncer=true :
# Prisma desactive alors les prepared statements, sinon les requetes echouent avec
# « prepared statement "s0" already exists ».
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&pgbouncer=true"

# Secret de signature des sessions JWT (32+ caracteres aleatoires)
AUTH_SECRET="change-me-with-a-long-random-string"

# Notifications e-mail (optionnel — si vide, les notifications restent in-app)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="ServiceNow360 <no-reply@example.com>"

# URL publique (liens dans les e-mails)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
